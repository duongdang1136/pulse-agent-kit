{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-agent-kit.dev/schemas/agent-manifest-v2.schema.json",
  "title": "Pulse Agent Package Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "display_name",
    "version",
    "description",
    "instructions",
    "skills",
    "templates",
    "knowledge",
    "output",
    "tags"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "templates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared",
        "project"
      ],
      "properties": {
        "shared": {
          "type": "boolean"
        },
        "project": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_skills": {
          "type": "integer",
          "minimum": 1
        },
        "fallback_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_template": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when_any",
              "skills"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer"
              },
              "when_any": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "skills": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "template": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    }
  }
}
