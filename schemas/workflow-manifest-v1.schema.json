{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse Workflow Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "display_name",
    "version",
    "description",
    "instructions",
    "inputs",
    "stages",
    "interaction",
    "tags"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "stages": {
      "type": "array",
      "minItems": 1
    },
    "interaction": {
      "type": "object"
    },
    "tags": {
      "type": "array"
    }
  }
}
